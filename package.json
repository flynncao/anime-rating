{
  "name": "anime-rating-monorepo",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Anime rating search application monorepo with frontend and backend",
  "author": "Flynn Cao",
  "license": "MIT",
  "keywords": [
    "anime",
    "rating",
    "vue",
    "express",
    "typescript",
    "monorepo"
  ],
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --stream run dev",
    "dev:server": "pnpm --filter server dev",
    "dev:client": "pnpm --filter client dev",
    "build": "pnpm --filter server build && pnpm --filter client build",
    "build:server": "pnpm --filter server build",
    "build:client": "pnpm --filter client build",
    "type-check": "pnpm --parallel run type-check",
    "type-check:server": "pnpm --filter server type-check",
    "type-check:client": "pnpm --filter client type-check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "pnpm --parallel run clean && rimraf node_modules",
    "install:all": "pnpm install"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.2.0",
    "@eslint/css": "^0.14.1",
    "@eslint/js": "^9.39.1",
    "@eslint/json": "^0.14.0",
    "@eslint/markdown": "^7.5.1",
    "@types/node": "^22.10.0",
    "@unocss/eslint-plugin": "^66.5.4",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^16.5.0",
    "rimraf": "^6.0.1",
    "typescript": "5.3.3",
    "typescript-eslint": "^8.46.3"
  }
}
