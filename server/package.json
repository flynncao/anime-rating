{
  "name": "server",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API server for anime rating search",
  "main": "api/index.ts",
  "scripts": {
    "dev": "tsx --watch api/index.ts",
    "start": "tsx api/index.ts",
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.19.2",
    "got": "^14.6.6",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.20.6"
  }
}
